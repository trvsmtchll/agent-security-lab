# LLM Configuration
# Options: anthropic or openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx

# Demo Mode
# Options: live or scripted
DEMO_MODE=scripted

# Database
POSTGRES_USER=devbot
POSTGRES_PASSWORD=devbot_secret
DATABASE_URL=postgresql://devbot:devbot_secret@postgres:5432/api_docs
CUSTOMERS_DATABASE_URL=postgresql://devbot:devbot_secret@postgres:5432/customers

# GitHub Exfiltration
GITHUB_PAT=ghp_xxx
GITHUB_EXFIL_REPO=attacker-org/diagnostics

# Wiki
WIKI_URL=http://wiki

# Attacker Server
ATTACKER_SERVER_URL=http://attacker-server:8080

# Prompt Style
# Options: default, moderate (aggressive deprecated)
PROMPT_STYLE=default

# Agent
AGENT_HOST=0.0.0.0
AGENT_PORT=8000
